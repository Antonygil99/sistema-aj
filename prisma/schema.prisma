generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
// Ruta AJ: curioso → diagnosticado → comparativo guiado → emisión; CLIENTE once converted.
enum ProspectStatus {
  CURIOSO
  DIAGNOSTICADO
  COMPARATIVO
  EMISION
  CLIENTE
  PERDIDO
}
enum MedicalHistory {
  SI
  NO
  NO_SABE
}
enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}
enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}
enum RenewalStatus {
  PENDING
  CONTACTED
  RENEWED
  LOST
}
enum ClaimStatus {
  OPEN
  IN_REVIEW
  CLOSED
}
enum ActivityStatus {
  PENDING
  DONE
}
enum ProductLine {
  MEDICAL
  AUTO
  LIFE
  HOME
  OTHER
}
model Prospect {
  id        String @id @default(cuid())
  name      String
  email     String?
  phone     String?
  source    String @default("manual")
  status    ProspectStatus @default(CURIOSO)
  notes     String?
  ownerEmail String?
  referredByClientId String?
  referredBy Client? @relation("Referrals", fields: [referredByClientId], references: [id], onDelete: Restrict)
  convertedClientId String? @unique
  convertedClient Client? @relation("Conversions", fields: [convertedClientId], references: [id], onDelete: Restrict)
  // Diagnosis (etapa 2): five questions. Medical history is recorded only as existence, never its detail.
  diagProtect String?
  diagDependents String?
  diagCare String?
  diagCoverage String?
  diagMedicalHistory MedicalHistory?
  diagPain String?
  quotes    Quote[]
  activities Activity[]
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([ownerEmail])
  @@index([referredByClientId])
}
model Client {
  id        String @id @default(cuid())
  name      String
  email     String?
  phone     String?
  taxId     String?
  policies  Policy[]
  quotes    Quote[]
  documents Document[]
  folders   DocumentFolder[]
  activities Activity[]
  referrals Prospect[] @relation("Referrals")
  contacts  ClientContact[]
  intake ClientIntake?
  procedures InsuranceProcedure[]
  emails    EmailMessage[]
  notices   ClientNotice[]
  convertedFrom Prospect? @relation("Conversions")
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
}

// One reusable administrative intake per client. Clinical and banking forms stay separate.
model ClientIntake {
  id String @id @default(cuid())
  clientId String @unique
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdById String
  tokenHash String? @unique
  pinHash String?
  expiresAt DateTime?
  accessHash String? @unique
  accessExpiresAt DateTime?
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  revision Int @default(0)
  status String @default("DRAFT")
  answers Json?
  approvedAnswers Json?
  approvedAt DateTime?
  revisions ClientIntakeRevision[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ClientIntakeRevision {
  id String @id @default(cuid())
  intakeId String
  intake ClientIntake @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  revision Int
  answers Json
  source String
  actorId String?
  privacyVersion String
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedById String?
  @@unique([intakeId, revision])
}
model Policy {
  renewalPreparation RenewalPreparation?
  procedures InsuranceProcedure[]
  id          String @id @default(cuid())
  number      String
  clientId    String
  client      Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  insurer     String
  product     String
  premium     Decimal @db.Decimal(12, 2)
  paymentFrequency String?
  sourceData  Json?
  // Imported/captured policy details (autos: vehicle, plates and use; any line: coverage or plan name).
  coverage    String?
  vehicle     String?
  plates      String?
  vehicleUse  String?
  productId   String?
  catalogProduct Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  ownerEmail  String?
  // Active delivery (Ruta AJ, etapa 5): a policy is complete only when all five checks are true.
  deliveredAt DateTime?
  deliveryReceived Boolean @default(false)
  deliveryUnderstood Boolean @default(false)
  deliveryKnowsContact Boolean @default(false)
  deliveryKnowsWhenToNotify Boolean @default(false)
  deliveryKnowsFirstStep Boolean @default(false)
  referralPotential Boolean @default(false)
  currency    String @default("MXN")
  startDate   DateTime
  endDate     DateTime
  status      PolicyStatus @default(ACTIVE)
  payments    Payment[]
  renewals    Renewal[]
  claims      Claim[]
  documents   Document[]
  activities  Activity[]
  previousPolicyId String? @unique
  previousPolicy Policy? @relation("PolicyRenewal", fields: [previousPolicyId], references: [id], onDelete: Restrict)
  nextPolicy Policy? @relation("PolicyRenewal")
  archivedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([clientId])
  @@index([status, endDate])
  @@index([productId])
  @@index([ownerEmail])
  @@unique([insurer, number, startDate])
}
model Quote {
  id         String @id @default(cuid())
  reference  String @unique
  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  product    String
  amount     Decimal @db.Decimal(12, 2)
  currency   String @default("MXN")
  status     QuoteStatus @default(DRAFT)
  validUntil DateTime?
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([prospectId])
  @@index([clientId])
}
model Payment {
  id        String @id @default(cuid())
  policyId  String
  policy    Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(12, 2)
  currency  String @default("MXN")
  dueDate   DateTime
  paidAt    DateTime?
  status    PaymentStatus @default(PENDING)
  reference String?
  evidenceDocumentId String?
  evidenceDocument Document? @relation("PaymentEvidence", fields: [evidenceDocumentId], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([policyId])
  @@index([status, dueDate])
}
model Renewal {
  id        String @id @default(cuid())
  policyId  String
  policy    Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  dueDate   DateTime
  status    RenewalStatus @default(PENDING)
  notes     String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([policyId, dueDate])
}
model Claim {
  id          String @id @default(cuid())
  reference   String @unique
  policyId    String
  policy      Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  description String
  occurredAt  DateTime
  status      ClaimStatus @default(OPEN)
  documents   Document[]
  activities  Activity[]
  archivedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([policyId, status])
}
model Document {
  deliveryKind String @default("INTERNAL")
  deliveryReviewed Boolean @default(false)
  deliveryReviewedBy String?
  procedureAttachments ProcedureAttachment[]
  paymentEvidence Payment[] @relation("PaymentEvidence")
  id         String @id @default(cuid())
  name       String
  storageKey String @unique
  mimeType   String
  folderId   String?
  folder     DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  policyId   String?
  policy     Policy? @relation(fields: [policyId], references: [id], onDelete: Restrict)
  claimId    String?
  claim      Claim? @relation(fields: [claimId], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([clientId])
  @@index([policyId])
  @@index([claimId])
  @@index([folderId])
}

model InsuranceProcedure {
  id String @id @default(cuid())
  requestKey String @unique
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  policyId String
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  createdById String
  formId String @default("metlife-cambios-gmm")
  revision Int @default(1)
  status String @default("DRAFT")
  data Json
  sourceSnapshot Json?
  followUpDate DateTime?
  submissionReference String?
  submittedAt DateTime?
  effectiveDate DateTime?
  revisions ProcedureRevision[]
  attachments ProcedureAttachment[]
  exports ProcedureExport[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId, status])
  @@index([policyId])
  @@index([followUpDate, status])
}
model InsuranceTemplate {
  id String @id
  sha256 String
  pdfBytes Bytes
  code String
  createdAt DateTime @default(now())
}
model ProcedureRevision {
  id String @id @default(cuid())
  procedureId String
  procedure InsuranceProcedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  revision Int
  status String
  snapshot Json
  actorId String
  createdAt DateTime @default(now())
  @@unique([procedureId, revision])
}
model ProcedureAttachment {
  id String @id @default(cuid())
  procedureId String
  procedure InsuranceProcedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  kind String
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([procedureId, kind, documentId])
}
model ProcedureExport {
  id String @id @default(cuid())
  procedureId String
  procedure InsuranceProcedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  revision Int
  storageKey String @unique
  sha256 String
  templateHash String
  createdAt DateTime @default(now())
  @@unique([procedureId, revision])
}
model DocumentFolder {
  id String @id @default(cuid())
  name String
  parentId String?
  parent DocumentFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children DocumentFolder[] @relation("FolderTree")
  clientId String?
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  documents Document[]
  // Color chosen in the library (ids in src/modules/documentos/folder-view.ts); null keeps the alternating tone.
  color String?
  // Archived folders (and everything inside) leave the library until restored.
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([parentId])
  @@index([clientId])
}
// Product catalog (Médica Vital, autos…): image stored in private R2, responsible by line.
model Product {
  id          String @id @default(cuid())
  name        String @unique
  insurer     String
  line        ProductLine @default(MEDICAL)
  description String?
  highlights  String?
  ownerEmail  String?
  imageKey    String? @unique
  imageType   String?
  policies    Policy[]
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Activity {
  id         String @id @default(cuid())
  title      String
  description String?
  dueDate    DateTime?
  status     ActivityStatus @default(PENDING)
  // Automatic follow-ups (SEGUIMIENTO_7/30/90) carry a kind; manual activities leave it empty.
  kind       String?
  ownerEmail String?
  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  policyId   String?
  policy     Policy? @relation(fields: [policyId], references: [id], onDelete: Restrict)
  claimId    String?
  claim      Claim? @relation(fields: [claimId], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  calendarMeetings CalendarMeeting[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([status, dueDate])
  @@index([prospectId])
  @@index([clientId])
  @@index([policyId])
  @@index([claimId])
  @@index([ownerEmail, status, dueDate])
  @@index([policyId, kind])
}
// Operational audit trail; also the source of in-app notifications.
model CrmEvent {
  id        String @id @default(cuid())
  action    String
  module    String
  recordId  String
  label     String
  actorId   String?
  actorName String
  actorEmail String?
  actorRole AccessRole?
  details   Json?
  auditOnly Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([module, recordId])
  @@index([actorEmail, createdAt])
  @@index([action, createdAt])
}
model WebhookEvent {
  id          String @id @default(cuid())
  payloadHash String @unique
  provider    String @default("whatsapp")
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
  @@index([processedAt, createdAt])
}
// Channel metadata only. Tokens stay in server environment variables.
model RenewalPreparation {
  id String @id @default(cuid())
  policyId String @unique
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  data Json
  status String @default("PREPARING")
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmResourceLink {
  id String @id @default(cuid())
  title String
  category String
  insurer String?
  url String
  audience String @default("INTERNAL")
  description String @default("")
  active Boolean @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([audience, active])
}

model WhatsAppChannel {
  id String @id @default(cuid())
  name String
  ownerEmail String
  phoneNumberId String? @unique
  wabaId String?
  credentialSlot String @unique
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerEmail, enabled])
}

// Each business number keeps its own contacts and history. Credentials never live here.
model WhatsAppConversation {
  id              String @id @default(cuid())
  phoneNumberId   String
  contactId       String
  displayName     String
  lastMessageAt   DateTime
  lastInboundAt   DateTime?
  closed          Boolean @default(false)
  createdAt       DateTime @default(now())
  messages        WhatsAppMessage[]
  @@unique([phoneNumberId, contactId])
  @@index([lastMessageAt, id])
}
model WhatsAppMessage {
  id              String @id @default(cuid())
  conversationId  String
  conversation    WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  metaId          String? @unique
  requestId       String? @unique
  direction       String
  kind            String
  body            String
  status          String
  sentAt          DateTime
  deliveredAt     DateTime?
  readAt          DateTime?
  senderId        String?
  senderName      String?
  failureCode     String?
  createdAt       DateTime @default(now())
  @@index([conversationId, sentAt, id])
}
// Delivery may arrive before the send response; retain it independently of the message row.
model WhatsAppReceipt {
  metaId        String @id
  phoneNumberId String
  status        String
  deliveredAt   DateTime?
  readAt        DateTime?
  failureCode   String?
  updatedAt     DateTime @updatedAt
}
model AgentRun {
  id         String @id @default(cuid())
  agent      String
  status     String @default("PENDING")
  input      Json
  output     Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([status, createdAt])
}

enum AccessRole {
  USER
  ADMIN
  SUPERADMIN
}
model AccessGrant {
  id String @id @default(cuid())
  email String @unique
  role AccessRole @default(USER)
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AuthUser {
  OauthClient_userId OauthClient[] @relation("OauthClient_userId")
  OauthRefreshToken_userId OauthRefreshToken[] @relation("OauthRefreshToken_userId")
  OauthAccessToken_userId OauthAccessToken[] @relation("OauthAccessToken_userId")
  OauthConsent_userId OauthConsent[] @relation("OauthConsent_userId")

  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions AuthSession[]
  accounts AuthAccount[]
  audits AccessAudit[]
  calendarConnection CalendarConnection?
  calendarMeetings CalendarMeeting[]
}
// Google credentials remain encrypted in AuthAccount; calendar ownership always comes from the session.
model CalendarConnection {
  userId String @id
  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled Boolean @default(true)
  connectNonce String?
  connectExpiresAt DateTime?
  connectedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CalendarMeeting {
  id String @id
  userId String
  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String?
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  title String
  description String @default("")
  location String @default("")
  startAt DateTime
  endAt DateTime
  attendees Json @default("[]")
  reminderMinutes Int?
  reminderMethod String @default("popup")
  useDefaultReminders Boolean @default(false)
  googleMeet Boolean @default(false)
  notifyGuests Boolean @default(false)
  // PENDING -> SYNCED -> CANCEL_PENDING -> CANCELLED; retry uses the same Google event ID.
  status String @default("PENDING")
  googleEventId String @unique
  googleUrl String?
  meetUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emails EmailMessage[]
  @@index([userId, startAt])
  @@index([activityId])
}
model AuthSession {
  OauthRefreshToken_sessionId OauthRefreshToken[] @relation("OauthRefreshToken_sessionId")
  OauthAccessToken_sessionId OauthAccessToken[] @relation("OauthAccessToken_sessionId")

  id String @id
  token String @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model AuthAccount {
  id String @id
  accountId String
  providerId String
  userId String
  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}
model AuthVerification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model AuthRateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}
model AccessAudit {
  id String @id @default(cuid())
  actorId String
  actor AuthUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  targetEmail String
  change Json
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([createdAt])
}
// Per-user UI preferences (view choices, guided tours). Keyed by the lowercase account email.
model UserPreference {
  email     String   @id
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}
// Extra people to write to about a client (HR of a company, a relative). Only contact data, never health details.
model ClientContact {
  id        String @id @default(cuid())
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  role      String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId])
}
enum EmailStatus {
  SENDING
  SCHEDULED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  CANCELLED
}
// Every email the CRM sends or schedules through Resend: the per-client history and, for agenda reminders, the
// handle (resendId) to move or cancel them. dedupeKey makes retries and double clicks send once.
model EmailMessage {
  id           String @id @default(cuid())
  kind         String
  dedupeKey    String @unique
  resendId     String? @unique
  status       EmailStatus @default(SENDING)
  to           String[]
  subject      String
  replyTo      String?
  attachments  Json @default("[]")
  clientId     String?
  client       Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  meetingId    String?
  meeting      CalendarMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  recordModule String?
  recordId     String?
  sentByName   String
  sentByEmail  String?
  scheduledAt  DateTime?
  sentAt       DateTime?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([clientId, createdAt])
  @@index([meetingId])
  @@index([kind, createdAt])
}
enum NoticeStatus {
  PENDING
  SENT
  NOTIFIED
  DISMISSED
  EXPIRED
}
// Client notices waiting for a person (src/modules/email/notices.ts): renewal 30/20/10 days before the end, receipt
// 20/10/0 days before it is due and a weekly follow-up of an open claim. Never sent on their own: someone sends the
// suggested email, records another channel (phone, WhatsApp) or dismisses it. Policy, receipt and claim ids are
// plain strings so a notice never blocks deleting them; a notice whose record no longer qualifies expires.
model ClientNotice {
  id              String @id @default(cuid())
  kind            String
  milestone       Int
  dedupeKey       String @unique
  clientId        String
  client          Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  policyId        String?
  paymentId       String?
  claimId         String?
  ownerEmail      String?
  dueDate         DateTime
  status          NoticeStatus @default(PENDING)
  channel         String?
  note            String?
  emailId         String?
  resolvedByName  String?
  resolvedByEmail String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status, ownerEmail])
  @@index([clientId])
}
// Team-wide email texts edited by the advisors (subject and body with {placeholders}); a kind without a row uses the
// suggested text in src/modules/email/template-text.ts.
model EmailTemplate {
  kind           String @id
  subject        String
  body           String
  updatedByName  String
  updatedByEmail String?
  updatedAt      DateTime @updatedAt
}

model Jwks {
  id String @id
  publicKey String
  privateKey String
  createdAt DateTime
  expiresAt DateTime?
  alg String?
  crv String?

}

model OauthClient {
  OauthClientResource_clientId OauthClientResource[] @relation("OauthClientResource_clientId")
  OauthRefreshToken_clientId OauthRefreshToken[] @relation("OauthRefreshToken_clientId")
  OauthAccessToken_clientId OauthAccessToken[] @relation("OauthAccessToken_clientId")
  OauthConsent_clientId OauthConsent[] @relation("OauthConsent_clientId")

  id String @id
  clientId String @unique
  clientSecret String?
  clientDiscoveryId String?
  disabled Boolean? @default(false)
  skipConsent Boolean?
  enableEndSession Boolean?
  subjectType String?
  scopes String[] @default([])
  clientCredentialsScopes String[] @default([])
  userId String?
  createdAt DateTime?
  updatedAt DateTime?
  name String?
  uri String?
  icon String?
  contacts String[] @default([])
  tos String?
  policy String?
  softwareId String?
  softwareVersion String?
  softwareStatement String?
  redirectUris String[] @default([])
  postLogoutRedirectUris String[] @default([])
  backchannelLogoutUri String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod String?
  applicationType String?
  jwks String?
  jwksUri String?
  grantTypes String[] @default([])
  responseTypes String[] @default([])
  requirePKCE Boolean?
  dpopBoundAccessTokens Boolean? @default(false)
  referenceId String?
  metadata Json?
  userIdRelation AuthUser? @relation("OauthClient_userId", fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
}

model OauthResource {
  OauthClientResource_resourceId OauthClientResource[] @relation("OauthClientResource_resourceId")

  id String @id
  identifier String @unique
  name String
  accessTokenTtl Int?
  refreshTokenTtl Int?
  signingAlgorithm String?
  signingKeyId String?
  allowedScopes String[] @default([])
  customClaims Json?
  dpopBoundAccessTokensRequired Boolean? @default(false)
  disabled Boolean? @default(false)
  createdAt DateTime?
  updatedAt DateTime?
  policyVersion Int? @default(1)
  metadata Json?

}

model OauthClientResource {
  id String @id
  clientId String
  resourceId String
  metadata Json?
  createdAt DateTime?
  clientIdRelation OauthClient @relation("OauthClientResource_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  @@index([clientId])
  resourceIdRelation OauthResource @relation("OauthClientResource_resourceId", fields: [resourceId], references: [identifier], onDelete: Cascade)
  @@index([resourceId])
  @@unique([clientId, resourceId])
}

model OauthRefreshToken {
  OauthAccessToken_refreshId OauthAccessToken[] @relation("OauthAccessToken_refreshId")

  id String @id
  token String @unique
  clientId String
  sessionId String?
  userId String
  referenceId String?
  authorizationCodeId String?
  resources String[] @default([])
  requestedUserInfoClaims String[] @default([])
  expiresAt DateTime
  createdAt DateTime
  revoked DateTime?
  rotatedAt DateTime?
  rotationReplayResponse String?
  rotationReplayExpiresAt DateTime?
  authTime DateTime?
  confirmation Json?
  scopes String[] @default([])
  clientIdRelation OauthClient @relation("OauthRefreshToken_clientId", fields: [clientId], references: [clientId], onDelete: Restrict)
  @@index([clientId])
  sessionIdRelation AuthSession? @relation("OauthRefreshToken_sessionId", fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([sessionId])
  userIdRelation AuthUser @relation("OauthRefreshToken_userId", fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
  @@index([authorizationCodeId])
}

model OauthAccessToken {
  id String @id
  token String @unique
  clientId String
  sessionId String?
  userId String?
  referenceId String?
  authorizationCodeId String?
  resources String[] @default([])
  requestedUserInfoClaims String[] @default([])
  refreshId String?
  expiresAt DateTime
  createdAt DateTime
  revoked DateTime?
  confirmation Json?
  scopes String[] @default([])
  clientIdRelation OauthClient @relation("OauthAccessToken_clientId", fields: [clientId], references: [clientId], onDelete: Restrict)
  @@index([clientId])
  sessionIdRelation AuthSession? @relation("OauthAccessToken_sessionId", fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([sessionId])
  userIdRelation AuthUser? @relation("OauthAccessToken_userId", fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
  @@index([authorizationCodeId])
  refreshIdRelation OauthRefreshToken? @relation("OauthAccessToken_refreshId", fields: [refreshId], references: [id], onDelete: Restrict)
  @@index([refreshId])
}

model OauthConsent {
  id String @id
  clientId String
  userId String?
  referenceId String?
  resources String[] @default([])
  requestedUserInfoClaims String[] @default([])
  scopes String[] @default([])
  createdAt DateTime
  updatedAt DateTime
  clientIdRelation OauthClient @relation("OauthConsent_clientId", fields: [clientId], references: [clientId], onDelete: Restrict)
  @@index([clientId])
  userIdRelation AuthUser? @relation("OauthConsent_userId", fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
}

model OauthClientAssertion {
  id String @id
  expiresAt DateTime

}

// Proposed MCP changes are immutable, short-lived, owned by one person and OAuth client.
model McpChange {
  id String @id @default(cuid())
  userId String
  clientId String
  module String
  operation String
  recordId String?
  expectedUpdatedAt DateTime?
  data Json
  fileBytes Bytes?
  status String @default("PENDING")
  resultId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status, expiresAt])
}
model McpRevocation {
  id String @id @default(cuid())
  userId String
  clientId String
  revokedBefore DateTime
  @@unique([userId, clientId])
}

// Reviewed contact imports. Raw spreadsheets/PDFs are not stored in the database.
model CrmImport {
  id String @id @default(cuid())
  userId String
  oauthClientId String?
  target String
  sourceName String
  sourceKind String
  sourceSha256 String?
  countryCode String?
  status String @default("READY")
  expiresAt DateTime
  appliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rows CrmImportRow[]
  @@index([userId, status, createdAt])
}
model CrmImportRow {
  id String @id @default(cuid())
  batchId String
  batch CrmImport @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int
  sourceRef String?
  data Json
  issues String[] @default([])
  warnings String[] @default([])
  allowNameMatch Boolean @default(false)
  reviewSnapshot Json?
  status String @default("PENDING")
  resultId String?
  @@unique([batchId, rowNumber])
}
