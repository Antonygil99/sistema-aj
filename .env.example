# Copiar a .env. Solo valores locales de ejemplo; reemplazar antes de desplegar.
DATABASE_URL="postgresql://aj:aj_local_only@localhost:5432/sistema_aj?schema=public"
# Opcional: conexión directa para migraciones. En Prisma se deriva del host pooled conocido si falta.
DIRECT_URL=
# Compatibilidad con instalaciones existentes: DATA_URL también se acepta como conexión.
POSTGRES_USER=aj
POSTGRES_PASSWORD=aj_local_only
POSTGRES_DB=sistema_aj
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AJ_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Versión habilitada en tu app de Meta, ejemplo: v26.0
WHATSAPP_API_VERSION=
# Asistentes (docs/asistentes.md): llaves de Anthropic (Claude Haiku/Sonnet) y OpenAI (GPT-6 Luna / GPT-6.1 Sol).
# Basta una; el modelo se elige en Preferencias.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Acceso Google (credenciales del servidor; nunca usar NEXT_PUBLIC_).
# La conexión MCP usa esta misma autorización por usuario; no requiere una clave de IA ni compartir AJ_API_TOKEN.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Autoriza las tareas programadas de Vercel: limpieza de logs y recordatorios de correo (valor aleatorio privado).
CRON_SECRET=

# Correo (Resend, docs/correo-resend.md). El remitente debe pertenecer a un dominio verificado.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=avisos@segurosaleyjoel.com
# Secreto del webhook de estados de entrega (whsec_…), desde Resend → Webhooks.
RESEND_WEBHOOK_SECRET=
# Opcional: enlace https al aviso de privacidad en el pie de los correos a clientes.
AJ_PRIVACY_URL=
# Cuenta principal y administradores iniciales; almacenar de forma privada.
AJ_SUPERADMIN_EMAIL=
AJ_ADMIN_EMAILS=

# Cloudflare R2 privado: credenciales S3 del servidor, nunca NEXT_PUBLIC_.
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
